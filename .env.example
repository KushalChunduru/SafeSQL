# --- LLM provider ---
# mock | openai | anthropic | gemini
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini: free tier via Google AI Studio (https://aistudio.google.com/apikey) - no cost, rate-limited.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Database ---
# duckdb | postgres
DB_BACKEND=duckdb
DUCKDB_PATH=data/safesql.duckdb

# Only used when DB_BACKEND=postgres (see docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safesql
POSTGRES_USER=safesql_app
POSTGRES_PASSWORD=safesql_app_pw
# Dedicated read-only role used by the query executor (defense in depth)
POSTGRES_READONLY_USER=safesql_reader
POSTGRES_READONLY_PASSWORD=safesql_reader_pw

# --- Guardrails ---
MAX_ROW_LIMIT=1000
MAX_SUBQUERY_DEPTH=3
MAX_EXPLAIN_ROW_ESTIMATE=500000
ENABLE_EXPLAIN_GUARDRAIL=true

# --- Hallucination detection ---
BACK_TRANSLATION_MIN_ALIGNMENT=0.55
ENABLE_MULTI_QUERY_VALIDATION=true
